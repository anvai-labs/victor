/* Victor interactive TUI (ADR-020).
   Colours reference the active Textual theme's variables (see themes.py) rather
   than hard-coded hex, so `victor tui --theme light|high-contrast` and the F6
   runtime cycle restyle the whole app. victor-dark reproduces the REPL's
   Dracula palette. */

Screen {
    background: $background;
    color: $foreground;
}

#body {
    height: 1fr;
}

#main-area {
    height: 1fr;
    width: 100%;
}

#session-bar {
    height: 2;
    padding: 0 1;
    background: $panel;
    color: $foreground;
    border-top: solid $primary;
}

#conversation {
    height: 1fr;
    width: 100%;
    padding: 0 1;
    background: $background;
    color: $foreground;
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-size: 1 1;
    scrollbar-gutter: auto;
}

#diff-pane {
    height: auto;
    max-height: 45%;
    padding: 0 1;
    border-top: solid $primary;
    background: $surface;
    color: $foreground;
    overflow-y: auto;
    scrollbar-size: 1 1;
}

#status-bar {
    height: 1;
    padding: 0 1;
    background: $panel;
    color: $secondary;
}

#prompt {
    height: 3;
    border: round $primary;
    background: $panel;
    color: $foreground;
}

#prompt:focus {
    border: round $accent;
}

/* ── Modal dialogs ─────────────────────────────────────────────── */

ApprovalScreen {
    align: center middle;
}

#approval-dialog {
    width: 80%;
    max-width: 100;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: thick $warning;
    background: $surface;
}

#approval-title { padding-bottom: 1; }
#approval-desc { color: $secondary; padding-bottom: 1; }
#approval-preview { height: auto; max-height: 24; }
#approval-actions { padding-top: 1; }

HelpScreen, CommandPalette {
    align: center middle;
}

#help-dialog, #palette-dialog {
    width: 80%;
    max-width: 100;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#palette-input { margin-bottom: 1; }
#palette-list { height: auto; max-height: 20; }

IntentConfirmationScreen {
    align: center middle;
}

#intent-dialog {
    width: 80%;
    max-width: 100;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: thick $warning;
    background: $surface;
}

#intent-title { padding-bottom: 1; }
#intent-task { color: $secondary; padding-bottom: 1; }
#intent-context { color: $secondary; padding-bottom: 1; }
#intent-options-title { padding-top: 1; padding-bottom: 1; }
#intent-option-1, #intent-option-2, #intent-option-3 { padding-bottom: 1; }
#intent-actions { padding-top: 1; }
