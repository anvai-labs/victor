# Development files
.vscode/**
.vscode-test/**
src/**
.gitignore
.yarnrc
vsc-extension-quickstart.md
**/tsconfig.json
**/.eslintrc.json
**/*.map
**/*.ts


# Build configuration
esbuild.config.js

# Node modules (bundled by esbuild)
node_modules/**

# Webview source (built files in out/webview)
webview-ui/**
!out/webview/**

# Test files
coverage/**
**/test-unit/**
**/test/**
**/*.test.ts
**/*.test.js

# The extension is bundled; ship only that bundle and built webview assets.
out/**
!out/extension.js
!out/webview/**
