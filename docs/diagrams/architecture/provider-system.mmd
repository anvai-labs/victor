%% Provider execution boundary: Victor policy above Sandhi's typed transport.
flowchart TB
    subgraph Victor["Victor provider policy"]
        Reg["ProviderRegistry.create()"]
        Resolve["resolve_transport_class()"]
        Policies["25 provider policies/adapters<br/>prompt, tools, capability and model selection"]
        Resilient["ResilientProvider<br/>logical-call retry and explicit fallback"]
        Native["Native-only adapters<br/>explicit protocol exceptions"]
    end

    subgraph Sandhi["Sandhi typed transport"]
        Wrapper["Sandhi transport wrappers<br/>victor/providers/sandhi_transport.py"]
        Direct["Direct FFI handle<br/>Victor endpoint/credential · max_retries=0"]
        Gateway["Gateway peer handle<br/>client dialect · virtual key or local starter"]
        Server["Sandhi gateway<br/>identity · upstream references · policy · budgets"]
        Ledger["Durable reservation, attempt<br/>settlement and receipt evidence"]
    end

    Cloud["Cloud provider endpoints"]
    Local["Local provider endpoints"]

    Reg --> Resolve
    Resolve -->|"admitted family"| Policies
    Resolve -->|"classified exception"| Native
    Resilient -->|"explicitly authorized attempt or fallback"| Reg
    Policies --> Wrapper
    Wrapper -->|"embedded observation · no ledger"| Direct
    Wrapper -->|"peer_role=sandhi_gateway_v1"| Gateway
    Gateway --> Server
    Server --> Ledger
    Direct --> Cloud
    Direct --> Local
    Server -->|"server-owned credential/reference"| Cloud
    Native --> Cloud
    Native --> Local

    %% No edge from Direct to Gateway: a failed or ambiguous call never replays
    %% through the other front door. Logical-call ownership stays in Victor.

    classDef victorStyle fill:#E3F2FD,stroke:#1976D2,stroke-width:2px
    classDef transportStyle fill:#F3E5F5,stroke:#7B1FA2,stroke-width:2px
    classDef endpointStyle fill:#E8F5E9,stroke:#388E3C,stroke-width:2px
    classDef durableStyle fill:#FFF3E0,stroke:#F57C00,stroke-width:2px

    class Reg,Resolve,Policies,Resilient,Native victorStyle
    class Wrapper,Direct,Gateway transportStyle
    class Cloud,Local endpointStyle
    class Server,Ledger durableStyle
